[server]
domain = localhost
root_url = http://localhost:3000
serve_from_sub_path = false

[security]
admin_user = admin
admin_password = admin

[auth.anonymous]
enabled = false

[auth.basic]
enabled = true

[users]
allow_sign_up = false
auto_assign_org = true
auto_assign_org_role = Viewer

[log]
level = info

[paths]
data = /var/lib/grafana
logs = /var/log/grafana
plugins = /var/lib/grafana/plugins

[metrics]
enabled = true
interval_seconds = 10

[unified_alerting]
enabled = true
execute_alerts = true