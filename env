# REDIS
REDIS_HOST=redis
REDIS_PORT=6379

# ЛОГИРОВАНИЕ
LOG_LEVEL=INFO
LOG_PATH=./logs

#  ДАННЫЕ ДЛЯ ТЕСТОВ
TEST_DB_URL=jdbc:h2:mem:testdb
