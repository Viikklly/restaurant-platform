#  В РЕАЛЬНОМ ПРОЕКТЕ ЭТОТ ФАЙЛ НЕ КОММИТЯТ В GIT
# Для учебного проекта оставляем дефолтные пароли для простоты запуска



ENVIRONMENT=production
SPRING_PROFILES_ACTIVE=prod

# EUREKA (SERVICE DISCOVERY)
# используем один сервер
EUREKA_URI=http://discovery-service:8761/eureka/

# KAFKA (БРОКЕР СООБЩЕНИЙ)
# используем один брокер
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# REDIS (КЭШ)
REDIS_HOST=redis
REDIS_PORT=6379

# ЛОГИРОВАНИЕ
LOG_LEVEL=INFO
LOG_PATH=./logs         # Локальная папка для логов

# БАЗЫ ДАННЫХ (ДЕФОЛТНЫЕ ПАРОЛИ)
DB_USER=postgres
DB_PASSWORD=postgres

# Индивидуальные URL для каждого сервиса
AUTH_DB_URL=jdbc:postgresql://postgres-auth:5432/authdb
ORDER_DB_URL=jdbc:postgresql://postgres-order:5432/orderdb
KITCHEN_DB_URL=jdbc:postgresql://postgres-kitchen:5432/kitchendb
PAYMENT_DB_URL=jdbc:postgresql://postgres-payment:5432/paymentdb

# KAFKA АУТЕНТИФИКАЦИЯ
# Kafka без аутентификации
# KAFKA_USER=
# KAFKA_PASSWORD=

# JPA НАСТРОЙКИ
JPA_DDL_AUTO=validate

# НАСТРОЙКИ БЕЗОПАСНОСТИ
# JWT секрет
JWT_SECRET=your-256-bit-secret-key-for-jwt-token-generation-please-change-me
JWT_EXPIRATION=86400000  # 24 часа в миллисекундах

# ВНЕШНИЕ СЕРВИСЫ (ДЛЯ УВЕДОМЛЕНИЙ)
# Для учебного проекта используем мок-сервисы
EMAIL_ENABLED=false
SMS_ENABLED=false
PUSH_ENABLED=false


# Таймауты
CONNECTION_TIMEOUT=5000
READ_TIMEOUT=10000

# Лимиты
MAX_ORDER_AMOUNT=100000
MAX_ITEMS_PER_ORDER=50