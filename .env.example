
# ШАБЛОН ПЕРЕМЕННЫХ ОКРУЖЕНИЯ
# В этом файле нет секретов



ENVIRONMENT=development
SPRING_PROFILES_ACTIVE=docker


EUREKA_URI=http://discovery-service:8761/eureka/


KAFKA_BOOTSTRAP_SERVERS=kafka:9092


REDIS_HOST=redis
REDIS_PORT=6379


LOG_LEVEL=INFO
LOG_PATH=./logs


DB_USER=postgres
DB_PASSWORD=postgres

AUTH_DB_URL=jdbc:postgresql://postgres-auth:5432/authdb
ORDER_DB_URL=jdbc:postgresql://postgres-order:5432/orderdb
KITCHEN_DB_URL=jdbc:postgresql://postgres-kitchen:5432/kitchendb
PAYMENT_DB_URL=jdbc:postgresql://postgres-payment:5432/paymentdb


JPA_DDL_AUTO=update


JWT_SECRET=change-this-secret-in-production
JWT_EXPIRATION=86400000


EMAIL_ENABLED=false
SMS_ENABLED=false
PUSH_ENABLED=false