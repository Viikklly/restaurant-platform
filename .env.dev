# ДЛЯ ЛОКАЛЬНОЙ РАЗРАБОТКИ


ENVIRONMENT=development
SPRING_PROFILES_ACTIVE=dev

# Локальные адреса (localhost вместо имен контейнеров)
EUREKA_URI=http://localhost:8761/eureka/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379

# Логирование в dev режиме
LOG_LEVEL=DEBUG
LOG_PATH=./logs/dev

# Базы данных для разработки (локальные порты)
AUTH_DB_URL=jdbc:postgresql://localhost:5437/authdb
ORDER_DB_URL=jdbc:postgresql://localhost:5433/orderdb
KITCHEN_DB_URL=jdbc:postgresql://localhost:5434/kitchendb
PAYMENT_DB_URL=jdbc:postgresql://localhost:5435/paymentdb

# Общие пароли (только для разработки!)
DB_USER=postgres
DB_PASSWORD=postgres

# JPA
JPA_DDL_AUTO=update

# JWT
JWT_SECRET=dev-secret-key-for-development-only
JWT_EXPIRATION=86400000

# ВНЕШНИЕ СЕРВИСЫ (МОКИ)
EMAIL_ENABLED=true
SMS_ENABLED=true
PUSH_ENABLED=true